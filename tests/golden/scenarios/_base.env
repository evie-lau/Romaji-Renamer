RATING_1_SOURCE=ANILIST
RATING_1_TYPE=audience
RATING_2_SOURCE=MAL
RATING_2_TYPE=critic
ALLOW_RENAMING=Yes
MAIN_TITLE_ENG=No
SORT_TITLE_ENG=No
ORIGINAL_TITLE_NATIVE=Yes
RENAME_SEASONS=Yes
REDUCE_TITLE_CAPS=Yes
DISABLE_TAGS=No
TAG_SOURCE=ANILIST
ADD_ANIME_TAG=Yes
ANILIST_TAGS_P=70
POSTER_DOWNLOAD=Yes
POSTER_SEASON_DOWNLOAD=Yes
POSTER_SOURCE=ANILIST
IGNORE_SEASONS=No
IGNORE_SEASONS_RATING=No
SEASON_YEAR=No
IGNORE_S1_ONLY_RATING=Yes
ANIME_AWARDS=Yes
ANIME_AWARDS_NO_FVA=Yes
ANILIST_LISTS=No
ANILIST_USERNAME=Arialz
ANILIST_LISTS_LEVEL=show
DATA_CACHE_TIME=5
CACHE_TIME_FINISHED=90
CACHE_TIME_AIRING=1
CACHE_TIME_UPCOMING=1
